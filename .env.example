# JWT (RS256)
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the full PEM content (including headers) as a single line with \n:
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
GROQ_API_KEY=

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=docuparse

# Redis
REDIS_URL=redis://redis:6379/0

# Service URLs (used by gateway reverse proxy)
DOCUMENT_SERVICE_URL=http://document:8001

# File uploads
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
